# ── Server ──
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# ── Authentication ──
API_KEY=change-me-to-a-strong-secret-at-least-16-chars

# ── Sessions ──
SESSIONS_DIR=./sessions

# ── Webhook ──
WEBHOOK_DIR=./webhooks
WEBHOOK_MAX_RETRIES=3
WEBHOOK_RETRY_DELAY_MS=1000

# ── Logging ──
LOG_LEVEL=info
LOG_PRETTY=true

# ── Docs ──
DOCS_ENABLED=true
