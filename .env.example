# ── Server ──
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# ── API Base URL ──
# Prefix for all API routes. No trailing slash.
# Examples: /api/v1, /wa, /gateway
BASE_URL=/

# ── Authentication ──
API_KEY=change-me-to-a-strong-secret-at-least-16-chars

# ── Sessions ──
SESSIONS_DIR=./sessions

# ── Webhook ──
WEBHOOK_DIR=./webhooks
WEBHOOK_MAX_RETRIES=5

# ── Webhook Batching ──
WEBHOOK_BATCH_MESSAGES=250
WEBHOOK_BATCH_CHATS=200

# ── Database ──
DB_PATH=./data/gateway.db

# ── Contact Cache ──
CONTACT_CACHE_SIZE=1000

# ── Logging ──
LOG_LEVEL=info
LOG_PRETTY=true

# ── Docs ──
DOCS_ENABLED=true
